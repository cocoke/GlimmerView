<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : aucune sauvegarde dans le cloud (les photos restent privées) ;
     le transfert direct vers un nouveau téléphone garde la collection, sans les modèles (retéléchargeables). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
