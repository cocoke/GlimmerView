<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Téléchargement des modèles d'IA à la demande -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Image fixe sur l'écran de verrouillage, ou retour à l'œuvre animée (permission normale) -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Ajoutée par le paquet officiel d'ONNX Runtime pour sa télémétrie. L'ONNX Runtime de l'app est
         compilé sans elle (tools/onnxruntime) ; ce retrait reste comme garde-fou (voir OrtPrivacy). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlimmerView">

        <!-- singleTask : une photo partagée rejoint l'app déjà ouverte au lieu d'en lancer
             une deuxième copie dans la tâche de l'app d'origine. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Menu « Partager » d'Android : une image venue d'une autre app devient une œuvre 3D -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Paquet .dwp partagé depuis une autre app -->
            <intent-filter android:label="@string/import_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-dwp+zip" />
            </intent-filter>
            <!-- « Ouvrir avec » : un .dwp touché dans Fichiers ou une messagerie. Le système ne connaît pas
                 l'extension et l'annonce souvent en application/octet-stream ; le contenu est vérifié avant tout import. -->
            <intent-filter android:label="@string/import_target_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-dwp+zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Le paquet officiel d'ONNX Runtime lance sa télémétrie Microsoft au démarrage de chaque processus.
             Absent de l'ONNX Runtime de l'app ; retrait gardé comme garde-fou. -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!-- Partage des fichiers .dwp exportés (dossier exports/ du cache) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/exports" />
        </provider>
    </application>
</manifest>
